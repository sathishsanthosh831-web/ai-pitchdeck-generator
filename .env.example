# Rename this file to .env and fill in your real values

# PostgreSQL - either set DATABASE_URL (what Render gives you) ...
DATABASE_URL=postgresql://user:password@host:5432/dbname
# ... or set these individually (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=pitchdeck_db
DB_PORT=5432

# AI / LLM API (Anthropic Claude used as example — swap for OpenAI etc. if you prefer)
ANTHROPIC_API_KEY=your_api_key_here

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret
FLASK_DEBUG=True
